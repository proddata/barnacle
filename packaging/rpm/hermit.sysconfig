# Hermit listens locally so HAProxy can terminate public TLS.
HERMIT_LISTEN=127.0.0.1:8080
HERMIT_PG_ADDR=127.0.0.1:5432
HERMIT_PG_SSLMODE=require
# HERMIT_PG_CA_FILE=/etc/hermit/postgres-ca.crt
HERMIT_PG_USER=postgres
HERMIT_PG_DATABASE=postgres
HERMIT_MAX_CONNECTIONS=32
HERMIT_CONSOLE=false
# Set both values to require RFC 9068 access tokens before HTTP or WebSocket reaches PostgreSQL.
# HERMIT_OIDC_ISSUER=https://issuer.example.com/
# HERMIT_OIDC_AUDIENCE=hermit-api
# Keep Go's garbage collector below the systemd service memory ceiling.
GOMEMLIMIT=160MiB
# Set HERMIT_ALLOWED_ORIGIN=https://app.example.com for a separate browser app.
