# Barnacle listens locally so HAProxy can terminate public TLS.
BARNACLE_LISTEN=127.0.0.1:8080
# To serve HTTPS/WSS directly, set both paths to a matching PEM pair.
# BARNACLE_TLS_CERT_FILE=/etc/pki/barnacle/server.crt
# BARNACLE_TLS_KEY_FILE=/etc/pki/barnacle/server.key
BARNACLE_PG_ADDR=127.0.0.1:5432
BARNACLE_PG_SSLMODE=require
# BARNACLE_PG_CA_FILE=/etc/barnacle/postgres-ca.crt
BARNACLE_MAX_CONNECTIONS=32
# Set both to serve metrics on a separate loopback listener.
# BARNACLE_METRICS=true
# BARNACLE_METRICS_LISTEN=127.0.0.1:9090
# BARNACLE_HTTP_READ_TIMEOUT=15s
# BARNACLE_HTTP_IDLE_TIMEOUT=60s
# Set both values to require RFC 9068 access tokens before HTTP or WebSocket reaches PostgreSQL.
# BARNACLE_OIDC_ISSUER=https://issuer.example.com/
# BARNACLE_OIDC_AUDIENCE=barnacle-api
# Keep Go's garbage collector below the systemd service memory ceiling.
GOMEMLIMIT=160MiB
# Set BARNACLE_ALLOWED_ORIGIN=https://app.example.com for a separate browser app.
# When HAProxy is the immediate peer and sets X-Forwarded-Proto, set
# BARNACLE_TRUSTED_PROXIES to its exact source IP and restrict direct access.
