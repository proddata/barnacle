# Build from the tested release binary, not from source or a Go toolchain.
# Create dist/barnacle-linux-amd64 and dist/barnacle-linux-arm64 first.
FROM gcr.io/distroless/static-debian13:nonroot
ARG TARGETARCH
COPY dist/barnacle-linux-${TARGETARCH} /usr/local/bin/barnacle
COPY LICENSE THIRD-PARTY-NOTICES.md /usr/share/doc/barnacle/
COPY THIRD-PARTY-LICENSES/ /usr/share/doc/barnacle/THIRD-PARTY-LICENSES/
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/barnacle"]
